	local function Create(ClassName, Props, Children)
		local Inst = Instance.new(ClassName)
		local Parent = nil
		if Props then
			for Prop, Value in next, Props do
				if Prop == "Parent" then
					Parent = Value
				else
					Inst[Prop] = Value
				end
			end
		end
		if Children then
			for _, Child in next, Children do
				Child.Parent = Inst
			end
		end
		if Parent then
			Inst.Parent = Parent
		end
		return Inst
	end

	local function Tween(Instance, Time, Props, Style, Direction)
		local Info = TweenInfo.new(Time or 0.25, Style or Enum.EasingStyle.Quart, Direction or Enum.EasingDirection.Out)
		local Tween = TweenService:Create(Instance, Info, Props)
		Tween:Play()
		return Tween
	end

	local function Pcall(Func, ...)
		local Success, Error = pcall(Func, ...)
		if not Success then
			warn("[Libary] " .. tostring(Error))
		end
	end

	local function CreateSignal()
		local Bindable = Create("BindableEvent")
		local Connections = {}
		local Signal = {}
		function Signal:Connect(Func)
			local Connection = Bindable.Event:Connect(Func)
			Connections[#Connections + 1] = Connection
			return Connection
		end
		function Signal:Fire(...)
			Bindable:Fire(...)
		end
		function Signal:DisconnectAll()
			for _, Connection in next, Connections do
				Connection:Disconnect()
			end
			Connections = {}
		end
		return Signal
	end

	local function round(Number, Increment)
		Increment = Increment or 1
		return math.floor(Number / Increment + 0.5) * Increment
	end

