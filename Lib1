			ScreenGui.Enabled = false
		end)

		local MinimizeButton = Create("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -36, 0, 8),
			Size = UDim2.new(0, 24, 0, 24),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Parent = Topbar
		})
		local MinimizeIcon = DrawIcon(MinimizeButton, "chevron-down", 12, 6, 6, Theme.Text_Dim)
		Darken(MinimizeButton)

		local Minimized = false
		local LastWindowSize = Info.Size
		MinimizeButton.MouseButton1Click:Connect(function()
			Minimized = not Minimized
			if Minimized then
				LastWindowSize = Window.Size
			end
			TweenService:Create(Window, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = Minimized and UDim2.new(0, LastWindowSize.X.Offset, 0, 40) or LastWindowSize
			}):Play()
			TweenService:Create(MinimizeIcon, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Rotation = Minimized and -90 or 0
			}):Play()
		end)

		MakeDraggable(Topbar, Window)

		-- Search bar
		local SearchFrame = Create("Frame", {
			Name = "SearchBar",
			Position = UDim2.new(0, 8, 0, 48),
			Size = UDim2.new(0, 164, 0, 28),
			BackgroundColor3 = Theme.Search_Background,
			BorderSizePixel = 0,
			Parent = Window
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("UIStroke", { Color = Theme.Outline, Thickness = 1 })
		})
		DrawIcon(SearchFrame, "search", 12, 9, 8, Theme.Text_Dim)

		-- Left rail (tabs)
		local LeftRail = Create("Frame", {
			Name = "LeftRail",
			Position = UDim2.new(0, 8, 0, 84),
			Size = UDim2.new(0, 164, 1, -92),
			BackgroundColor3 = Theme.LeftBar,
			BorderSizePixel = 0,
			Parent = Window
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 10) })
		})

		local LeftTabs = Create("ScrollingFrame", {
			Name = "Tabs",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 6, 0, 6),
			Size = UDim2.new(1, -12, 1, -12),
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 1,
			ScrollBarImageColor3 = Theme.Outline,
			BorderSizePixel = 0,
			Parent = LeftRail
		}, {
			Create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder })
		})
		HandleCanvasSize(LeftTabs)

		-- Main area (columns)
		local MainArea = Create("Frame", {
			Name = "MainArea",
			Position = UDim2.new(0, 180, 0, 48),
			Size = UDim2.new(1, -188, 1, -56),
			BackgroundColor3 = Theme.Main_Background,
			BorderSizePixel = 0,
			Parent = Window
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 10) })
		})

		local ColumnList = Create("ScrollingFrame", {
			Name = "Columns",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 8, 0, 8),
			Size = UDim2.new(1, -16, 1, -16),
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.Outline,
			BorderSizePixel = 0,
			Parent = MainArea
		}, {
			Create("UIListLayout", {
				Padding = UDim.new(0, 14),
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder
			})
		})
		HandleCanvasSize(ColumnList)

		-- Resize grip
		local ResizeGrip = Create("Frame", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -2, 1, -2),
			Size = UDim2.new(0, 16, 0, 16),
			BackgroundTransparency = 1,
			Parent = Window
		}, {
			Create("Frame", {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -3, 1, -3),
				Size = UDim2.new(0, 9, 0, 1),
				Rotation = -45,
				BackgroundColor3 = Theme.Text_Dim,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				ZIndex = 2
			}),
			Create("Frame", {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -3, 1, -8),
				Size = UDim2.new(0, 5, 0, 1),
				Rotation = -45,
				BackgroundColor3 = Theme.Text_Dim,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				ZIndex = 2
			})
		})
		MakeResizeable(ResizeGrip, Window)

		-- Search input (filters tabs)
		local function ApplySearch(Text)
			Text = Text and string.lower(Text) or ""
			for _, Tab in next, Library.Tabs do
				Tab.TabButton.Visible = Text == "" or string.find(string.lower(Tab.Name), Text, 1, true) ~= nil
			end
		end
		local _, _, SearchInput = CreateTextBox({
			Parent = SearchFrame,
			Position = UDim2.new(0, 28, 0, 0),
			Size = UDim2.new(1, -34, 1, 0),
			Placeholder = "Search for tabs...",
			TextSize = 12,
			CornerRadius = 8,
			OnChanged = ApplySearch
		})

		-- live filtering like a web search input
		SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
			if SearchInput.Text == "/" then
				SearchInput.Text = "" -- pressing "/" also types the character; strip it
			end
			ApplySearch(SearchInput.Text)
		end)

		-- "/" focuses the search box, Escape blurs it (web-like)
		UserInputService.InputBegan:Connect(function(Input, Typing)
			if Typing then
				return
			end
			if Input.KeyCode == Enum.KeyCode.Slash and not UserInputService:GetFocusedTextBox() then
				SearchInput:CaptureFocus()
			end
		end)

		-- window hide/show keybind
		UserInputService.InputBegan:Connect(function(Input, Typing)
			if Typing then
				return
			end
			if Input.KeyCode == Info.ToggleKeybind then
				ScreenGui.Enabled = not ScreenGui.Enabled
			end
		end)

		Library.Tabs = {}
		Library.CurrentTab = nil
		Library.ActiveSection = nil
		Library.RailOrder = 0

		Library.Window = {
			Name = Info.Name,
			ScreenGui = ScreenGui,
			Frame = Window,
			Topbar = Topbar,
			LeftRail = LeftRail,
			LeftTabs = LeftTabs,
			MainArea = MainArea,
			ColumnList = ColumnList,
			ToggleKeybind = Info.ToggleKeybind
		}

		return Library.Window
	end

	-- ///////////////////////////////////////////////////////////////////////////////////////////////////
	-- // Tabs / Sections
	-- ///////////////////////////////////////////////////////////////////////////////////////////////////

	function Library:CreateTab(Info)
		Info = Info or {}
		Info.Name = Info.Name or "Tab"
		Info.Icon = Info.Icon or nil

		assert(Library.Window, "[Libary] Create a window first (Library:CreateWindow)")

		local Window = Library.Window
		local IsFirst = #Library.Tabs == 0

		local TabButton = Create("TextButton", {
			Name = Info.Name,
			BackgroundColor3 = Theme.Tab_Button,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 32),
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = Library.RailOrder + 1,
			Parent = Window.LeftTabs
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) })
		})
		Darken(TabButton)

		local TabIcon = nil
		if Info.Icon then
			TabIcon = DrawIcon(TabButton, Info.Icon, 14, 10, 9, Theme.Text_Dim)
		end

		local TabText = Create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, Info.Icon and 30 or 12, 0, 0),
			Size = UDim2.new(1, Info.Icon and -36 or -20, 1, 0),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = Theme.Text_Inactive,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = Info.Name,
			Parent = TabButton
		})

		local TabContainer = Create("Frame", {
			Name = Info.Name,
			BackgroundTransparency = 1,
			Visible = false,
			Size = UDim2.new(1, 0, 1, 0),
			Parent = Window.ColumnList,
			LayoutOrder = #Library.Tabs + 1
		})

		local Tab = {
			Name = Info.Name,
			TabButton = TabButton,
			TabIcon = TabIcon,
			TextLabel = TabText,
			Container = TabContainer,
			Columns = {},
			ColumnCount = 0,
			LastSection = {},
			LastSectionOrder = {}
		}
		Library.Tabs[#Library.Tabs + 1] = Tab

		-- rail order (tabs and captions share one ordered list)
		Library.RailOrder = Library.RailOrder + 1
		TabButton.LayoutOrder = Library.RailOrder
		TabContainer.LayoutOrder = #Library.Tabs

		-- a freshly created tab becomes the build target, so elements created
		-- right after CreateTab land inside it
		Library.CurrentTab = Tab
		Library.ActiveSection = nil

		TabButton.MouseButton1Click:Connect(function()
			Library:ShowTab(Info.Name)
		end)

		if IsFirst then
			Library:ShowTab(Info.Name)
		end

		return Tab
	end

	function Library:ShowTab(Name)
		for _, Tab in next, Library.Tabs do
			local Active = Tab.Name == Name
			Tab.Container.Visible = Active
			TweenService:Create(Tab.TextLabel, TweenInfo.new(0.2), {
				TextColor3 = Active and Theme.Text_Active or Theme.Text_Inactive
			}):Play()
			TweenService:Create(Tab.TabButton, TweenInfo.new(0.2), {
				BackgroundTransparency = Active and 0 or 1
			}):Play()
			if Tab.TabIcon then
				SetIconColor(Tab.TabIcon, Active and Theme.Text_Active or Theme.Text_Dim)
			end
			if Active then
				Library.CurrentTab = Tab
				Library.ActiveSection = nil
			end
		end
	end

	-- caption inside the left rail (like "General" / "World" / "Other" in the reference)
	function Library:AddRailSection(Info)
		Info = Info or {}
		Info.Name = Info.Name or "Section"
		assert(Library.Window, "[Libary] Create a window first (Library:CreateWindow)")

		Create("Frame", {
			Name = "RailCaption",
			BackgroundColor3 = Theme.Tab_Caption,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 20),
			LayoutOrder = Library.RailOrder + 1,
			Parent = Library.Window.LeftTabs
		}, {
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 6),
				Size = UDim2.new(1, -18, 0, 12),
				Font = Enum.Font.GothamMedium,
				TextSize = 10,
				TextColor3 = Theme.Text_Dim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = string.upper(Info.Name)
			})
		})

		Library.RailOrder = Library.RailOrder + 1
	end

	-- column inside the active tab ("Left" or "Right")
	local function GetColumn(Tab, Side)
		if not Tab.Columns[Side] then
			Tab.ColumnCount = Tab.ColumnCount + 1
			local Column = Create("Frame", {
				Name = "Column" .. Side,
				BackgroundTransparency = 1,
				Position = Side == "Right" and UDim2.new(0.5, 7, 0, 0) or UDim2.new(),
				Size = UDim2.new(0.5, -7, 1, 0),
				Parent = Tab.Container,
				LayoutOrder = Tab.ColumnCount
			})
			local SectionList = Create("ScrollingFrame", {
				Name = "SectionList",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				CanvasSize = UDim2.new(),
				ScrollBarThickness = 1,
				ScrollBarImageColor3 = Theme.Outline,
				BorderSizePixel = 0,
				Parent = Column
			}, {
				Create("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder })
			})
			HandleCanvasSize(SectionList)
			Tab.Columns[Side] = SectionList
		end
		return Tab.Columns[Side]
	end

	-- caption card inside a column ("Select the category" style)
	function Library:AddSection(Info)
		Info = Info or {}
		Info.Name = Info.Name or "General"
		assert(Library.CurrentTab, "[Libary] Create a tab first (Library:CreateTab)")

		local Side = Info.Side and (string.lower(Info.Side) == "right" and "Right" or "Left") or "Left"
		local Tab = Library.CurrentTab
		local SectionList = GetColumn(Tab, Side)

		local Section = Create("Frame", {
			Name = "Section",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = SectionList,
			LayoutOrder = (Tab.LastSectionOrder[Side] or 0) + 1
		}, {
			Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
		})
		Section:SetAttribute("ElementOrder", 0)

		if Info.Name ~= "" then
			Create("TextLabel", {
				Name = "Caption",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 18),
				Font = Enum.Font.GothamMedium,
				TextSize = 11,
				TextColor3 = Theme.Text_Inactive,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = string.upper(Info.Name),
				Parent = Section
			})
		end

		Tab.LastSection[Side] = Section
		Tab.LastSectionOrder[Side] = (Tab.LastSectionOrder[Side] or 0) + 1

		Library.ActiveSection = Section

		return Section
	end

	-- resolve where an element should be parented (respects optional Info.Side)
	local function PrepareInfo(Info)
		Info = Info or {}
		if not Library.CurrentTab then
			Library:CreateTab({ Name = "Main" })
		end
		if Info.Side then
			local Side = string.lower(Info.Side) == "right" and "Right" or "Left"
			local Tab = Library.CurrentTab
			if Tab.LastSection[Side] then
				Library.ActiveSection = Tab.LastSection[Side]
			else
				Library:AddSection({ Name = "", Side = Side })
			end
		end
		if not Library.ActiveSection or not Library.ActiveSection.Parent then
			Library:AddSection({ Name = "General" })
		end
		-- per-section element counter keeps LayoutOrder stable when mixing sides
		local ElementOrder = (Library.ActiveSection:GetAttribute("ElementOrder") or 0) + 1
		Library.ActiveSection:SetAttribute("ElementOrder", ElementOrder)
		Info.__Parent = Library.ActiveSection
		Info.__Order = ElementOrder
		return Info
	end

	-- wrap all element creators so they support Info.Side routing automatically
	for _, ElementName in next, { "Toggle", "Slider", "Dropdown", "Button", "Textbox", "Keybind", "Label", "Paragraph" } do
		local Original = Library[ElementName]
		Library[ElementName] = function(self, Info)
			return Original(self, PrepareInfo(Info))
		end
	end

	-- ///////////////////////////////////////////////////////////////////////////////////////////////////
	-- // Lifecycle
	-- ///////////////////////////////////////////////////////////////////////////////////////////////////

	function Library:Destroy()
		if Library.Window then
			pcall(function()
				Library.Window.ScreenGui:Destroy()
			end)
			Library.Window = nil
		end
		Library.Tabs = {}
		Library.CurrentTab = nil
		Library.ActiveSection = nil
	end
end

return Library
