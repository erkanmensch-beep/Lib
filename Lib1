local function New(className, properties, children)
	local object = Instance.new(className)

	for property, value in next, properties or {} do
		object[property] = value
	end

	for _, child in next, children or {} do
		child.Parent = object
	end

	return object
end

local function Tween(object, duration, properties, style)
	return TweenService:Create(
		object,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		properties
	)
end

local function Connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(Library.Connections, connection)
	return connection
end

local function WithDefaults(config, defaults)
	local options = {}

	for key, value in next, defaults do
		options[key] = value
	end

	for key, value in next, config or {} do
		if value ~= nil then
			options[key] = value
		end
	end

	return options
end

local function GetContainer(explicit)
	if typeof(explicit) == "Instance" then
		return explicit
	end

	local success, hidden = pcall(function()
		return gethui()
	end)

	if success and typeof(hidden) == "Instance" then
		return hidden
	end

	local ok, core = pcall(function()
		return game:GetService("CoreGui")
	end)

	if ok and typeof(core) == "Instance" then
		return core
	end

	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function ToColor(value)
	if typeof(value) == "Color3" then
		return value
	end

	if typeof(value) == "string" and value:match("^#%x%x%x%x%x%x$") then
		return Color3.fromHex(value)
	end

	return nil
end

local function GetNoise()
	if NoiseTexture.Loaded then
		return NoiseTexture.Content
	end

	NoiseTexture.Loaded = true

	local success, content = pcall(function()
		local image = game:GetService("AssetService"):CreateEditableImage({
			Size = Vector2.new(NoiseSize, NoiseSize),
		})

		local pixels = buffer.create(NoiseSize * NoiseSize * 4)

		for index = 0, NoiseSize * NoiseSize - 1 do
			local value = math.random(0, 255)
			local offset = index * 4
			local shade = value < 128 and 0 or 255

			buffer.writeu8(pixels, offset, shade)
			buffer.writeu8(pixels, offset + 1, shade)
			buffer.writeu8(pixels, offset + 2, shade)
			buffer.writeu8(pixels, offset + 3, math.abs(value - 128) * 2)
		end

		image:WritePixelsBuffer(Vector2.zero, Vector2.new(NoiseSize, NoiseSize), pixels)

		return Content.fromObject(image)
	end)

	if success then
		NoiseTexture.Content = content
	end

	return NoiseTexture.Content
end

local function CreateNoise(parent, transparency, radius)
	local content = GetNoise()

	if not content then
		return nil
	end

	local noise = New("ImageLabel", {
		Name = "Noise",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(NoiseSize, NoiseSize),
		ImageTransparency = transparency,
		Parent = parent,
	}, {
		New("UICorner", {
			CornerRadius = UDim.new(0, radius),
		}),
	})

	if not pcall(function()
		noise.ImageContent = content
	end) then
		noise:Destroy()
		return nil
	end

	return noise
end

function IconPack.Load()
	if IconPack.Loaded then
		return IconPack.Data
	end

	IconPack.Loaded = true

	local success, source = pcall(function()
		return (game.HttpGet and game:HttpGet(IconPack.Source)) or HttpService:GetAsync(IconPack.Source)
	end)

	if not success or typeof(source) ~= "string" then
		return nil
	end

	local compile = loadstring or load
	local compiled, chunk = pcall(compile, source)

	if not compiled or typeof(chunk) ~= "function" then
		return nil
	end

	local ok, data = pcall(chunk)

	if ok and typeof(data) == "table" then
		IconPack.Data = data
	end

	return IconPack.Data
end

function Library:ResolveIcon(icon)
	if typeof(icon) ~= "string" or icon == "" then
		return nil
	end

	if icon:match("^rbxassetid://%d+") or icon:match("^rbxasset://") or icon:match("^https?://") then
		return icon
	end

	local pack = IconPack.Load()
	return pack and pack[icon] or nil
end

function Library:SetVisible(value)
	Library.Visible = value and true or false

	if Library.Window and Library.Window.UI.Gui then
		Library.Window.UI.Gui.Enabled = Library.Visible
	end
end

function Library:Toggle()
	Library:SetVisible(not Library.Visible)
end

function Library:Destroy()
	for _, connection in next, Library.Connections do
		connection:Disconnect()
	end

	table.clear(Library.Connections)

	if Library.Window and Library.Window.UI.Gui then
		Library.Window.UI.Gui:Destroy()
	end

	Library.Window = nil
end

