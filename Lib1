			TweenService:Create(SliderDot, TweenInfo.new(0.1), { Size = UDim2.new(0, 14, 0, 14) }):Play()
		end)
		SliderDot.MouseLeave:Connect(function()
			TweenService:Create(SliderDot, TweenInfo.new(0.1), { Size = UDim2.new(0, 12, 0, 12) }):Play()
		end)

		local function SetFromInput()
			-- GetMouseLocation shares the coordinate space of AbsolutePosition because
			-- the ScreenGui uses IgnoreGuiInset = true
			local MouseX = UserInputService:GetMouseLocation().X
			local Alpha = math.clamp((MouseX - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
			SliderFrame:Set(Info.Min + (Info.Max - Info.Min) * Alpha, true)
		end

		function SliderFrame:Set(Value, NoSignal)
			Value = math.clamp(Value, Info.Min, Info.Max)
			Info.Value = Value
			if Info.Flag then
				Library.Flags[Info.Flag] = Value
			end
			local Alpha = (Value - Info.Min) / (Info.Max - Info.Min)
			if Info.Format then
				SliderValue.Text = string.format(Info.Format, Value)
			else
				local Whole = Info.Min % 1 == 0 and Info.Max % 1 == 0
				SliderValue.Text = Whole and tostring(math.floor(Value)) or string.format("%.2f", Value)
			end
			TweenService:Create(SliderFill, TweenInfo.new(0.05), { Size = UDim2.new(Alpha, 0, 1, 0) }):Play()
			if not NoSignal then
				Pcall(Info.Callback, Value)
			end
		end

		SliderFrame:Set(Info.Default, true)

		local Dragging = false
		local ActiveInput = nil

		local function BeginDrag(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Dragging = true
				ActiveInput = Input
				SetFromInput()
			end
		end

		SliderTrack.InputBegan:Connect(BeginDrag)
		SliderDot.InputBegan:Connect(BeginDrag)

		UserInputService.InputEnded:Connect(function(Input)
			if Input == ActiveInput then
				Dragging = false
				ActiveInput = nil
			end
		end)

		UserInputService.InputChanged:Connect(function(Input)
			if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				SetFromInput(Input)
			end
		end)

		return SliderFrame
	end

