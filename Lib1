				PaddingTop = UDim.new(0, 4),
				PaddingLeft = UDim.new(0, 4),
				PaddingRight = UDim.new(0, 4),
				PaddingBottom = UDim.new(0, 4),
			}),
			New("UIListLayout", {
				Padding = UDim.new(0, 2),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})

		local Dropdown = {}
		local optionsById = {}

		local function SetOpen(open)
			if open then
				local origin = box.AbsolutePosition - overlay.AbsolutePosition

				popup.Position = UDim2.fromOffset(origin.X + box.AbsoluteSize.X, origin.Y + box.AbsoluteSize.Y + 4)
				popup.Size = UDim2.fromOffset(box.AbsoluteSize.X, math.min(#values * 30 + 8, 180))
			end

			popup.Visible = open
		end

		local function Build()
			for _, option in next, optionsById do
				option:Destroy()
			end

			table.clear(optionsById)

			for index, optionValue in next, values do
				local name = tostring(optionValue)

				local option = New("TextButton", {
					Name = name,
					Size = UDim2.new(1, 0, 0, 28),
					BackgroundColor3 = theme.Accent,
					BackgroundTransparency = optionValue == selected and 0 or 1,
					AutoButtonColor = false,
					Text = name,
					FontFace = Fonts.Medium,
					TextSize = 13,
					TextColor3 = theme.Text,
					TextTransparency = optionValue == selected and 0 or 0.3,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					LayoutOrder = index,
					Parent = optionList,
				}, {
					New("UICorner", {
						CornerRadius = UDim.new(0, ControlRadius),
					}),
					New("UIPadding", {
						PaddingLeft = UDim.new(0, 8),
						PaddingRight = UDim.new(0, 8),
					}),
				})

				Connect(option.MouseEnter, function()
					if optionValue ~= selected then
						Tween(option, 0.1, {
							BackgroundTransparency = 0.94,
						}):Play()
					end
				end)

				Connect(option.MouseLeave, function()
					if optionValue ~= selected then
						Tween(option, 0.1, {
							BackgroundTransparency = 1,
						}):Play()
					end
				end)

				Connect(option.MouseButton1Click, function()
					Dropdown:Set(optionValue)
					SetOpen(false)
				end)

				optionsById[option] = option
			end
		end

		function Dropdown:Set(optionValue, silent)
			selected = optionValue
			label.Text = tostring(selected)

			Build()

			if not silent and elementOptions.OnChanged then
				elementOptions.OnChanged(selected)
			end

			return Dropdown
		end

		function Dropdown:Get()
			return selected
		end

		function Dropdown:Refresh(newValues)
			values = table.clone(newValues or values)
			Build()

			if not table.find(values, selected) then
				Dropdown:Set(values[1], true)
			end

			return Dropdown
		end

		Build()

		Connect(box.MouseButton1Click, function()
			SetOpen(not popup.Visible)
		end)

		Connect(UserInputService.InputBegan, function(input)
			if not popup.Visible or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end

			if not IsInside(box, input.Position) and not IsInside(popup, input.Position) then
				SetOpen(false)
			end
		end)

		table.insert(section.Elements, Dropdown)
		return Dropdown
	end

