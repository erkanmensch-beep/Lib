	local function DrawIcon(Parent, Name, Size, OffsetX, OffsetY, Color)
		local Icon = Create("Frame", {
			Name = "Icon",
			Size = UDim2.new(0, Size, 0, Size),
			Position = UDim2.new(0, OffsetX or 0, 0, OffsetY or 0),
			BackgroundTransparency = 1,
			Parent = Parent,
			ZIndex = Parent.ZIndex
		})
		local Def = Icons[Name]
		if not Def then
			return Icon
		end
		Color = Color or Theme.Text
		local Scale = Size / 24

		local function MakeLine(x1, y1, x2, y2, Thickness)
			local dx, dy = x2 - x1, y2 - y1
			local Length = math.sqrt(dx * dx + dy * dy)
			local Angle = math.deg(math.atan2(dy, dx))
			Create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, x1 * Scale, 0, y1 * Scale),
				Size = UDim2.new(0, Length * Scale, 0, math.max(1, (Thickness or 1.7) * Scale)),
				Rotation = Angle,
				BackgroundColor3 = Color,
				BorderSizePixel = 0,
				Parent = Icon,
				ZIndex = Icon.ZIndex
			})
		end

		local function MakeCircle(cx, cy, r, Filled)
			local Frame = Create("Frame", {
				Position = UDim2.new(0, (cx - r) * Scale, 0, (cy - r) * Scale),
				Size = UDim2.new(0, 2 * r * Scale, 0, 2 * r * Scale),
				BackgroundColor3 = Color,
				BackgroundTransparency = Filled and 0 or 1,
				BorderSizePixel = 0,
				Parent = Icon,
				ZIndex = Icon.ZIndex
			}, {
				Create("UICorner", { CornerRadius = UDim.new(1, 0) })
			})
			if not Filled then
				Create("UIStroke", { Color = Color, Thickness = math.max(1, 1.7 * Scale), Parent = Frame })
			end
		end

		local function MakeRRect(x, y, w, h, Rad)
			local Frame = Create("Frame", {
				Position = UDim2.new(0, (x + 0.85) * Scale, 0, (y + 0.85) * Scale),
				Size = UDim2.new(0, math.max(1, (w - 1.7) * Scale), 0, math.max(1, (h - 1.7) * Scale)),
				BackgroundTransparency = 1,
				Parent = Icon,
				ZIndex = Icon.ZIndex
			}, {
				Create("UICorner", { CornerRadius = UDim.new(0, Rad * Scale) }),
				Create("UIStroke", { Color = Color, Thickness = math.max(1, 1.7 * Scale) })
			})
		end

		Pcall(Def, MakeLine, MakeCircle, MakeRRect)
		return Icon
	end

	local function SetIconColor(Icon, Color)
		for _, Child in next, Icon:GetChildren() do
			if Child:IsA("Frame") then
				Child.BackgroundColor3 = Color
				local Stroke = Child:FindFirstChildOfClass("UIStroke")
				if Stroke then
					Stroke.Color = Color
				end
			end
		end
	end

	-- ///////////////////////////////////////////////////////////////////////////////////////////////////
	-- // Interaction helpers (hover darken, drag, resize, auto canvas size, text input)
	-- ///////////////////////////////////////////////////////////////////////////////////////////////////

	local function Darken(Instance)
		local DarkFrame = Create("Frame", {
			Name = "Darken",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = false, -- never sink input; hover + clicks must pass through
			Parent = Instance,
			ZIndex = Instance.ZIndex
		})
		Instance.MouseEnter:Connect(function()
			TweenService:Create(DarkFrame, TweenInfo.new(0.1), { BackgroundTransparency = 0.82 }):Play()
		end)
		Instance.MouseLeave:Connect(function()
			TweenService:Create(DarkFrame, TweenInfo.new(0.1), { BackgroundTransparency = 1 }):Play()
		end)
		return DarkFrame
	end

	local function MakeDraggable(DragPoint, MoveTarget, Callback)
		local Dragging = false
		local DragStart, StartPos
		DragPoint.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Dragging = true
				DragStart = Input.Position
				StartPos = MoveTarget.Position -- track the moved frame, not the drag handle
				Input.Changed:Connect(function()
					if Input.UserInputState == Enum.UserInputState.End then
						Dragging = false
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(Input)
			if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				local Delta = Input.Position - DragStart
				local NewPos = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
				MoveTarget.Position = NewPos
				Pcall(Callback, NewPos)
			end
		end)
	end

	local function MakeResizeable(DragPoint, ResizeTarget, Callback)
		local Dragging = false
		local DragStart, StartSize
		DragPoint.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Dragging = true
				DragStart = Input.Position
				StartSize = ResizeTarget.Size
				Input.Changed:Connect(function()
					if Input.UserInputState == Enum.UserInputState.End then
						Dragging = false
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(Input)
			if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				local Delta = Input.Position - DragStart
				local NewSize = UDim2.new(
					0, math.clamp(StartSize.X.Offset + Delta.X, 460, 900),
					0, math.clamp(StartSize.Y.Offset + Delta.Y, 380, 640)
				)
				ResizeTarget.Size = NewSize
				Pcall(Callback, NewSize)
			end
		end)
	end

	local function HandleCanvasSize(ListFrame)
		local ListLayout = ListFrame:FindFirstChildOfClass("UIListLayout")
		if ListLayout then
			ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				ListFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 8)
			end)
		end
	end

	-- textbox: TextLabel shown, hidden TextBox takes focus on click (like contenteditable)
	local function CreateTextBox(Info)
		Info = Info or {}
		local TextFrame = Create("Frame", {
			Name = "TextBox",
			Size = Info.Size or UDim2.new(1, 0, 1, 0),
			Position = Info.Position or UDim2.new(),
			AnchorPoint = Info.AnchorPoint or Vector2.new(),
			BackgroundColor3 = Theme.TextBox_Background,
			BorderSizePixel = 0,
			Active = true,
			Parent = Info.Parent,
			ZIndex = (Info.Parent and Info.Parent.ZIndex or 1) + 1
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, Info.CornerRadius or 6) }),
			Create("UIStroke", { Color = Theme.Outline, Thickness = 1 })
		})
		Darken(TextFrame)

		local TextLabel = Create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -12, 1, 0),
			Position = UDim2.new(0, 8, 0, 0),
			Font = Enum.Font.Gotham,
			TextSize = Info.TextSize or 12,
			TextColor3 = Info.Text and Theme.Text or Theme.Text_Dim,
			TextXAlignment = Info.Alignment or Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = Info.Text or Info.Placeholder or "",
			Parent = TextFrame,
			ZIndex = TextFrame.ZIndex
		})

		local TextBox = Create("TextBox", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -12, 1, 0),
			Position = UDim2.new(0, 8, 0, 0),
			Font = Enum.Font.Gotham,
			TextSize = Info.TextSize or 12,
			TextColor3 = Theme.Text_Active,
			TextXAlignment = Info.Alignment or Enum.TextXAlignment.Left,
			Text = "",
			ClearTextOnFocus = false,
			Visible = false,
			Parent = TextFrame,
			ZIndex = TextFrame.ZIndex
		})

		local FocusedThread = nil
		local function Blur()
			if FocusedThread then
				task.cancel(FocusedThread)
				FocusedThread = nil
			end
			TextBox:ReleaseFocus()
			TextBox.Visible = false
			TextLabel.TextColor3 = Info.Text and Theme.Text or Theme.Text_Dim
		end

		TextFrame.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				if FocusedThread then
					task.cancel(FocusedThread)
				end
				TextLabel.TextColor3 = Theme.Text_Active
				TextBox.Text = TextLabel.Text
				TextBox.Visible = true
				TextBox:CaptureFocus()
				FocusedThread = task.spawn(function()
					task.wait(10)
					Blur()
				end)
			end
		end)

		TextBox.FocusLost:Connect(function(EnterPressed)
			if FocusedThread then
				task.cancel(FocusedThread)
				FocusedThread = nil
			end
			TextLabel.Text = TextBox.Text ~= "" and TextBox.Text or (Info.Placeholder or "")
			TextLabel.TextColor3 = Info.Text and Theme.Text or Theme.Text_Dim
			TextBox.Visible = false
			Pcall(Info.OnChanged, TextLabel.Text, EnterPressed)
		end)

		TextBox:GetPropertyChangedSignal("Text"):Connect(function()
			if TextBox.Visible and Info.Max and #TextBox.Text > Info.Max then
				TextBox.Text = string.sub(TextBox.Text, 1, Info.Max)
			end
		end)

		return TextFrame, TextLabel, TextBox, Blur
	end

