		})

		local DropdownArrow = DrawIcon(DropdownList, "chevron-down", 12, DropdownList.AbsoluteSize.X - 22, 9, Theme.Text_Dim)
		DropdownArrow.Position = UDim2.new(1, -22, 0, 9)
		DropdownArrow.ZIndex = DropdownFrame.ZIndex

		local DropdownOpen = Create("Frame", {
			Name = "Open",
			Position = UDim2.new(0, 0, 1, 6),
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = Theme.Dropdown_Open,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Visible = false,
			Parent = DropdownList,
			ZIndex = DropdownFrame.ZIndex + 50
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
			Create("UIStroke", { Color = Theme.Outline, Thickness = 1 }),
			Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
		})

		local function IsOpen()
			return DropdownOpen.Visible
		end

		local function UpdateSize()
			local Count = 0
			for _, Child in next, DropdownOpen:GetChildren() do
				if Child:IsA("TextButton") then
					Count = Count + 1
				end
			end
			DropdownOpen:SetAttribute("FullSize", Count * 36 - 2)
		end

		local StoredZIndexes = nil
		function DropdownFrame:ToggleDropdown(Boolean)
			Boolean = Boolean == nil and not IsOpen() or Boolean
			if Boolean and not IsOpen() then
				-- raise the whole ancestor chain (element -> section -> list -> column)
				-- so the open list overlays sibling columns as well
				StoredZIndexes = {}
				local Node = DropdownFrame
				for _ = 1, 4 do
					if not Node then
						break
					end
					StoredZIndexes[#StoredZIndexes + 1] = { Node, Node.ZIndex }
					Node.ZIndex = 50
					Node = Node.Parent
				end
				DropdownOpen.Visible = true
				TweenService:Create(DropdownOpen, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, 0, 0, DropdownOpen:GetAttribute("FullSize") or 0)
				}):Play()
				TweenService:Create(DropdownArrow, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Rotation = 180
				}):Play()
			elseif not Boolean and IsOpen() then
				if StoredZIndexes then
					for _, Saved in next, StoredZIndexes do
						Saved[1].ZIndex = Saved[2]
					end
					StoredZIndexes = nil
				end
				local CloseTween = TweenService:Create(DropdownOpen, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, 0, 0, 0)
				})
				CloseTween:Play()
				CloseTween.Completed:Connect(function()
					if not IsOpen() then
						DropdownOpen.Visible = false
					end
				end)
				TweenService:Create(DropdownArrow, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Rotation = 0
				}):Play()
			end
		end

		function DropdownFrame:Set(Option, NoSignal)
			DropdownValue.Text = tostring(Option)
			DropdownValue.TextColor3 = Theme.Text
			if Info.Flag then
				Library.Flags[Info.Flag] = Option
			end
			if not NoSignal then
				Pcall(Info.Callback, Option)
			end
		end

		local FirstRun = true
		function DropdownFrame:Refresh(Options)
			Info.Options = Options or Info.Options
			DropdownOpen:ClearAllChildren()
			Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = DropdownOpen })
			Create("UIStroke", { Color = Theme.Outline, Thickness = 1, Parent = DropdownOpen })
			Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = DropdownOpen })
			for Index, Option in next, Info.Options do
				local OptionButton = Create("TextButton", {
					Size = UDim2.new(1, 0, 0, 34),
					BackgroundColor3 = Theme.Dropdown_Option,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextColor3 = Theme.Text_Inactive,
					TextXAlignment = Enum.TextXAlignment.Left,
					Text = "  " .. tostring(Option),
					TextTruncate = Enum.TextTruncate.AtEnd,
					AutoButtonColor = false,
					LayoutOrder = Index,
					Parent = DropdownOpen,
					ZIndex = DropdownOpen.ZIndex
				})
				OptionButton.MouseEnter:Connect(function()
					TweenService:Create(OptionButton, TweenInfo.new(0.1), { BackgroundTransparency = 0.4 }):Play()
				end)
				OptionButton.MouseLeave:Connect(function()
					TweenService:Create(OptionButton, TweenInfo.new(0.1), { BackgroundTransparency = 1 }):Play()
				end)
				OptionButton.MouseButton1Click:Connect(function()
					DropdownFrame:Set(Option)
					DropdownFrame:ToggleDropdown(false)
				end)
			end
			UpdateSize()
			if FirstRun and Info.Default then
				FirstRun = false
				DropdownFrame:Set(Info.Default, true)
			end
		end
		DropdownFrame:Refresh(Info.Options)

		DropdownList.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				DropdownFrame:ToggleDropdown()
			end
		end)

		-- click-away closes any open dropdown
		UserInputService.InputBegan:Connect(function(Input, Typing)
			if Typing or not IsOpen() then
				return
			end
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				local Mouse = Input.Position
				local AbsPos = DropdownFrame.AbsolutePosition
				local AbsSize = DropdownFrame.AbsoluteSize
				local OpenHeight = DropdownOpen.AbsoluteSize.Y
				local InFrame = Mouse.X >= AbsPos.X and Mouse.X <= AbsPos.X + AbsSize.X
					and Mouse.Y >= AbsPos.Y and Mouse.Y <= AbsPos.Y + AbsSize.Y + OpenHeight
				if not InFrame then
					DropdownFrame:ToggleDropdown(false)
				end
			end
		end)

		return DropdownFrame
	end

