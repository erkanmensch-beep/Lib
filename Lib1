	local function CreateElementFrame(Type, Info, Size, Divider, LabelHeight)
		Info.Text = Info.Text or Type

		local ElementFrame = Create("Frame", {
			Name = "Element",
			BackgroundColor3 = Theme.Element_Background,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			Active = true,
			Size = Size,
			Parent = Info.__Parent,
			LayoutOrder = Info.__Order,
			ZIndex = 5
		}, {
			Create("UICorner", { CornerRadius = UDim.new(0, 8) })
		})

		ElementFrame.MouseEnter:Connect(function()
			TweenService:Create(ElementFrame, TweenInfo.new(0.1), { BackgroundTransparency = 0.25 }):Play()
		end)
		ElementFrame.MouseLeave:Connect(function()
			TweenService:Create(ElementFrame, TweenInfo.new(0.1), { BackgroundTransparency = 0.4 }):Play()
		end)

		if Divider then
			Create("Frame", {
				Name = "Divider",
				Size = UDim2.new(1, 0, 0, 1),
				Position = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = Theme.Divider,
				BorderSizePixel = 0,
				Parent = ElementFrame,
				ZIndex = ElementFrame.ZIndex
			})
		end

		local ElementMain = Create("Frame", {
			Name = "Main",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			Parent = ElementFrame,
			ZIndex = ElementFrame.ZIndex
		})

		local ElementLabel = Create("TextLabel", {
			Name = "Label",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -90, 0, LabelHeight or 36),
			Position = UDim2.new(0, 12, 0, 0),
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = Info.Text,
			Parent = ElementFrame,
			ZIndex = ElementFrame.ZIndex
		})

		return ElementFrame, ElementMain, ElementLabel
	end

