	function Library:Toggle(Info)
		Info = Info or {}
		Info.Text = Info.Text or "Toggle"
		Info.State = Info.State or Info.Default or false
		Info.Callback = Info.Callback or function() end
		Info.Flag = Info.Flag or nil

		local ToggleFrame, ToggleMain, ToggleLabel = CreateElementFrame("Toggle", Info, UDim2.new(1, 0, 0, 36), false)

		local ToggleSwitch = Create("Frame", {
			Size = UDim2.new(0, 36, 0, 20),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -18, 0.5, 0),
			BackgroundColor3 = Theme.Toggle_Background,
			BorderSizePixel = 0,
			Parent = ToggleFrame,
			ZIndex = ToggleFrame.ZIndex
		}, {
			Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			Create("UIStroke", { Color = Theme.Outline, Thickness = 1 })
		})
		Darken(ToggleSwitch)

		local ToggleButton = Create("Frame", {
			Size = UDim2.new(0, 12, 0, 12),
			Position = Info.State and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 4, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Info.State and Theme.Toggle_On or Theme.Toggle_Off,
			BorderSizePixel = 0,
			Parent = ToggleSwitch,
			ZIndex = ToggleFrame.ZIndex
		}, {
			Create("UICorner", { CornerRadius = UDim.new(1, 0) })
		})

		local TweenNewState = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

		function ToggleFrame:Set(Boolean)
			Boolean = Boolean == nil and not Info.State or Boolean
			Info.State = Boolean
			if Info.Flag then
				Library.Flags[Info.Flag] = Boolean
			end
			TweenService:Create(ToggleButton, TweenNewState, {
