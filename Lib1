				end
				Listening = false
				KeybindButton.TextColor3 = Theme.Text_Inactive
				if Input.KeyCode == Enum.KeyCode.Escape then
					Info.Key = nil
					KeybindButton.Text = "None"
				elseif Input.KeyCode ~= Enum.KeyCode.Unknown then
					Info.Key = Input.KeyCode
					KeybindButton.Text = Info.Key.Name
				elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
					Info.Key = "MB2"
					KeybindButton.Text = "MB2"
				end
				Pcall(Info.Callback, Info.Key)
			elseif not Typing and not UserInputService:GetFocusedTextBox() and Info.Key then
				local Pressed = false
				if typeof(Info.Key) == "EnumItem" then
					Pressed = Input.KeyCode == Info.Key
				elseif Info.Key == "MB2" then
					Pressed = Input.UserInputType == Enum.UserInputType.MouseButton2
				end
				if Pressed then
					Pcall(Info.OnPressed)
				end
			end
		end)

