			}),
		})

		local hitbox = New("TextButton", {
			Name = "Hitbox",
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.new(0, 0, 0, 32),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Parent = row,
		})

		local Slider = {}
		local dragging = false

		function Slider:Set(newValue, silent)
			value = math.clamp(newValue, elementOptions.Min, elementOptions.Max)

			local fraction = (value - elementOptions.Min) / (elementOptions.Max - elementOptions.Min)

			fill.Size = UDim2.fromScale(fraction, 1)
			thumb.Position = UDim2.fromScale(fraction, 0.5)
			valueLabel.Text = string.format(elementOptions.Format, value)

			if not silent and elementOptions.OnChanged then
				elementOptions.OnChanged(value)
			end

			return Slider
		end

		function Slider:Get()
			return value
		end

		Slider:Set(value, true)

		local function Update(input)
			local fraction = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			Slider:Set(elementOptions.Min + (elementOptions.Max - elementOptions.Min) * fraction)
		end

		Connect(hitbox.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			dragging = true
			Update(input)
		end)

		Connect(UserInputService.InputChanged, function(input)
			if not dragging then
				return
			end

			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			Update(input)
		end)

		Connect(UserInputService.InputEnded, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			dragging = false
		end)

		table.insert(section.Elements, Slider)
		return Slider
	end

