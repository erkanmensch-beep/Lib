	local CreateTabInGroup

	local function GroupHeight(count)
		return TabHeight * count + TabSpacing * math.max(count - 1, 0)
	end

	local function ResolveTabGroup(requested)
		if typeof(requested) == "table" and requested.Window == Window and requested.Tabs then
			return requested
		end

		return nil
	end

	function Window:CreateTabGroup(config)
		local groupOptions = WithDefaults(config, {
			Bare = false,
			Padding = nil,
		})

		local bare = groupOptions.Bare and true or false
		local inset = bare and 0 or (groupOptions.Padding or TabGroupPadding)

		local group = {
			Window = Window,
			Bare = bare,
			Inset = inset,
			Index = #Window.TabGroups + 1,
			Tabs = {},
			ContentHeight = 0,
			UI = {},
		}

		local card = New("Frame", {
			Name = "Tabs",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = theme.TabGroup,
			BackgroundTransparency = bare and 1 or 0,
			BorderSizePixel = 0,
			LayoutOrder = group.Index,
			Parent = list,
		}, {
			New("UICorner", {
				CornerRadius = UDim.new(0, TabGroupRadius),
			}),
			New("UIPadding", {
				PaddingTop = UDim.new(0, inset),
				PaddingLeft = UDim.new(0, inset),
				PaddingRight = UDim.new(0, inset),
				PaddingBottom = UDim.new(0, inset),
			}),
		})

		local groupContent = New("Frame", {
			Name = "Content",
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 1,
			Parent = card,
		}, {
			New("UIListLayout", {
				Padding = UDim.new(0, TabSpacing),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})		group.UI = {
			Card = card,
			Content = groupContent,
		}

		function group:SetVisible(value)
			card.Visible = value and true or false
			return group
		end

		function group:AddTab(tabConfig)
			return CreateTabInGroup(group, tabConfig)
		end

		group.CreateTab = group.AddTab

		table.insert(Window.TabGroups, group)

		return group
	end

	function Window:GetDefaultGroup()
		if not Window.DefaultGroup then
			Window.DefaultGroup = Window:CreateTabGroup({ Bare = true })
		end

		return Window.DefaultGroup
	end

	function Window:Animate(tab, key, object, duration, properties, style)
		local current = tab.Tweens[key]

		if current then
			current:Cancel()
		end

		tab.Tweens[key] = Tween(object, duration, properties, style)
		tab.Tweens[key]:Play()
	end

	function Window:UpdateIndicator(animated)
		local tab = Window.Selected

		if not tab then
			return
		end

		local card = tab.TabGroup.UI.Card
		local target = UDim2.new(0, 0, 0, (tab.Index - 1) * (TabHeight + TabSpacing))

		if Window.IndicatorTween then
			Window.IndicatorTween:Cancel()
			Window.IndicatorTween = nil
		end

		indicator.BackgroundColor3 = tab.Accent
		indicator.Visible = true

		-- Changing sections reparents the pill, so it reappears in place instead of flying over.
		if indicator.Parent ~= card then
			indicator.Parent = card
			indicator.Position = target
			return
		end

		if not animated then
			indicator.Position = target
			return
		end

		Window.IndicatorTween = Tween(indicator, 0.45, {
			Position = target,
		}, Enum.EasingStyle.Quint)

		Window.IndicatorTween:Play()
	end

	function Window:IsDefaultTab(tab)
		local target = options.DefaultTab

		if typeof(target) == "number" then
			return tab.Order == target
		end

		if typeof(target) == "string" then
			return tab.Title:lower() == target:lower()
		end

		return false
	end

	function Window:Refresh()
		for _, tab in next, Window.Tabs do
			local active = tab == Window.Selected
			local hovered = tab.Hovered and not active
			local foreground = theme.TabTextTransparency

			if active then
				foreground = theme.TabTextTransparencyActive
			elseif hovered then
				foreground = theme.TabTextTransparencyHover
			end

			Window:Animate(tab, "Button", tab.UI.Button, 0.15, {
				BackgroundColor3 = theme.TabBackgroundHover,
				BackgroundTransparency = hovered and theme.TabBackgroundHoverTransparency or 1,
			})

			Window:Animate(tab, "Title", tab.UI.Title, 0.15, {
				TextTransparency = foreground,
			})

			if tab.UI.Icon then
				Window:Animate(tab, "Icon", tab.UI.Icon, 0.15, {
					ImageTransparency = foreground,
				})
			end
		end
	end

	function Window:SelectTab(tab)
		if typeof(tab) == "string" then
			for _, item in next, Window.Tabs do
				if item.Title:lower() == tab:lower() then
					tab = item
					break
				end
			end
		end

		if typeof(tab) ~= "table" or tab.Window ~= Window or tab == Window.Selected then
			return
		end

		local previous = Window.Selected
		local direction = previous and (tab.Order > previous.Order and 1 or -1) or 1

		Window.Selected = tab
		Window:Refresh()

		if previous then
			Window:Animate(previous, "Page", previous.UI.Group, 0.2, {
				GroupTransparency = 1,
			})

			task.delay(0.2, function()
				if previous ~= Window.Selected then
					previous.UI.Group.Visible = false
				end
			end)
		end

		local group = tab.UI.Group

		group.Position = UDim2.fromOffset(24 * direction, 0)
		group.GroupTransparency = 1
		group.Visible = true

		Window:Animate(tab, "Page", group, 0.35, {
			Position = UDim2.fromOffset(0, 0),
			GroupTransparency = 0,
		})

		Window:UpdateIndicator(previous ~= nil)
	end

	CreateTabInGroup = function(tabGroup, config)
		local tabOptions = WithDefaults(typeof(config) == "string" and { Title = config } or config, {
			Title = "Tab",
			Icon = nil,
			Accent = nil,
		})

		local iconAsset = Library:ResolveIcon(tabOptions.Icon)

		local tab = {
			Window = Window,
			TabGroup = tabGroup,
			Title = tabOptions.Title,
			Index = #tabGroup.Tabs + 1,
			Order = #Window.Tabs + 1,
			Accent = ToColor(tabOptions.Accent) or theme.Accent,
			Hovered = false,
			Sections = {},
			Tweens = {},
			UI = {},
		}

		local page = New("ScrollingFrame", {
			Name = tabOptions.Title,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 0,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, {
			New("UIPadding", {
				PaddingTop = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 10),
				PaddingRight = UDim.new(0, 10),
				PaddingBottom = UDim.new(0, 10),
			}),
			New("UIListLayout", {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})

		local pageGroup = New("CanvasGroup", {
			Name = tabOptions.Title,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			GroupTransparency = 1,
			Visible = false,
			Parent = content,
		}, {
			page,
		})

		local button = New("TextButton", {
			Name = tabOptions.Title,
			Size = UDim2.new(1, 0, 0, TabHeight),
			BackgroundColor3 = theme.TabBackgroundHover,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = tab.Index,
			Parent = tabGroup.UI.Content,
		}, {
			New("UICorner", {
				CornerRadius = UDim.new(0, TabRadius),
			}),
			New("UIPadding", {
				PaddingLeft = UDim.new(0, TabPadding),
				PaddingRight = UDim.new(0, TabPadding),
			}),
			New("UIListLayout", {
				Padding = UDim.new(0, TabGap),
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})

		local iconLabel

		if iconAsset then
			iconLabel = New("ImageLabel", {
				Name = "Icon",
				Image = iconAsset,
				ImageColor3 = theme.Text,
				ImageTransparency = theme.TabTextTransparency,
				Size = UDim2.fromOffset(TabIconSize, TabIconSize),
				LayoutOrder = 1,
				BackgroundTransparency = 1,
				Parent = button,
			})
		end

		local titleLabel = New("TextLabel", {
			Name = "Title",
			Text = tabOptions.Title,
			FontFace = Fonts.Medium,
			TextSize = 15,
			TextColor3 = theme.Text,
			TextTransparency = theme.TabTextTransparency,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, -(TabPadding * 2 + (iconAsset and TabIconSize + TabGap or 0)), 1, 0),
			LayoutOrder = 2,
			BackgroundTransparency = 1,
			Parent = button,
		})

		tab.UI = {
			Button = button,
			Icon = iconLabel,
			Title = titleLabel,
			Page = page,
			Group = pageGroup,
		}

		function tab:Select()
			Window:SelectTab(tab)
		end

		function tab:AddSection(sectionConfig)
			return CreateSection(tab, sectionConfig)
		end

		Connect(button.MouseEnter, function()
			tab.Hovered = true
			Window:Refresh()
		end)

		Connect(button.MouseLeave, function()
			tab.Hovered = false
			Window:Refresh()
		end)

		Connect(button.MouseButton1Click, function()
			Window:SelectTab(tab)
		end)

		table.insert(tabGroup.Tabs, tab)
		table.insert(Window.Tabs, tab)

		tabGroup.ContentHeight = GroupHeight(#tabGroup.Tabs)
		tabGroup.UI.Content.Size = UDim2.new(1, 0, 0, tabGroup.ContentHeight)

		if not Window.Selected or Window:IsDefaultTab(tab) then
			Window:SelectTab(tab)
		end

		return tab
	end

	function Window:CreateTab(config)
		local requested = typeof(config) == "table" and config.TabGroup
		local tabGroup = ResolveTabGroup(requested) or Window:GetDefaultGroup()

		return CreateTabInGroup(tabGroup, config)
	end

	local dragging = false
	local dragStart, dragOrigin

	Connect(header.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			dragOrigin = root.Position
		end
	end)

	Connect(UserInputService.InputChanged, function(input)
		if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			dragOrigin.X.Scale,
			dragOrigin.X.Offset + delta.X,
			dragOrigin.Y.Scale,
			dragOrigin.Y.Offset + delta.Y
		)
	end)

	Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	if options.ToggleKey then
		Connect(UserInputService.InputBegan, function(input, processed)
			if processed or input.KeyCode ~= options.ToggleKey then
				return
			end

			Library:Toggle()
		end)
	end

	Tween(root, 0.3, { Size = UDim2.fromOffset(options.Size.X, options.Size.Y) }):Play()

	Library.Window = Window
	return Window
end

return Library
